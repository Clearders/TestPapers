{
  "name": "testpapers",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/run-nuxi.mjs build",
    "check": "npm run check:runtime-config && npm run check:data-model && npm run check:e2e-lock && node scripts/check-auth-ssr-state.mjs && node scripts/check-csp-hardening.mjs && node scripts/check-paper-domain.mjs && node scripts/check-shared-drafts.mjs && node scripts/check-paper-persistence-flow.mjs && node scripts/check-realtime-backoff.mjs && node scripts/check-realtime-presence-contract.mjs && node scripts/run-nuxi.mjs build",
    "verify": "npm run contract:check && npm run lint && npm run typecheck && npm run check",
    "verify:ci": "npm run verify && npm run check:dependencies && npm run e2e:fullstack",
    "contract:generate": "openapi-typescript contracts/openapi.json --output app/generated/cloud-api.d.ts --alphabetize",
    "contract:check": "npm run contract:check:lock && npm run contract:check:generated && npm run check:sync-contract",
    "contract:check:generated": "openapi-typescript contracts/openapi.json --output app/generated/cloud-api.d.ts --alphabetize --check",
    "contract:check:lock": "node scripts/check-contract-lock.mjs",
    "check:csp-hardening": "node scripts/check-csp-hardening.mjs",
    "check:paper-domain": "node scripts/check-paper-domain.mjs",
    "check:shared-drafts": "node scripts/check-shared-drafts.mjs",
    "check:realtime-backoff": "node scripts/check-realtime-backoff.mjs",
    "check:realtime-presence": "node scripts/check-realtime-presence-contract.mjs",
    "check:auth-ssr-state": "node scripts/check-auth-ssr-state.mjs",
    "check:data-model": "node scripts/check-data-model-contract.mjs",
    "check:e2e-lock": "node scripts/check-e2e-backend-lock.mjs",
    "check:runtime-config": "node scripts/check-runtime-config.mjs",
    "check:sync-contract": "node scripts/check-sync-contract.mjs",
    "check:dependencies": "npm audit --omit=dev --audit-level=high",
    "check:e2e": "npm run e2e:fullstack",
    "e2e:fullstack": "playwright test",
    "dev": "node scripts/run-nuxi.mjs dev",
    "generate": "node scripts/run-nuxi.mjs generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "pm2:start": "pm2 start .output/server/index.mjs --name testpapers",
    "preview": "node scripts/run-nuxi.mjs preview",
    "smoke:workspace": "node scripts/smoke-workspace-flow.mjs",
    "postinstall": "node scripts/run-nuxi.mjs prepare",
    "start": "pm2 start .output/server/index.mjs --name testpapers"
  },
  "dependencies": {
    "cropperjs": "^2.1.1",
    "katex": "^0.16.21",
    "nuxt": "4.5.1",
    "nuxt-security": "2.5.1",
    "vue": "^3.5.32",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "1.62.1",
    "eslint": "^10.5.0",
    "fflate": "0.8.3",
    "openapi-typescript": "7.13.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
