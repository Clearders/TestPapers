# Select one of: local, development, test, staging, production.
# local and development use the safe defaults below when values are omitted.
TESTPAPERS_ENV=local

# Canonical server-to-server endpoint. Do not include credentials, query strings, or secrets.
NUXT_API_BASE=http://127.0.0.1:8000/api/v1
# Legacy fallback only. Leave unset; never set it differently from NUXT_API_BASE.
# NUXT_SERVER_API_BASE=

# Browser-visible API endpoint. Use /api/v1 with the same-origin Nginx proxy.
NUXT_PUBLIC_API_BASE=/api/v1
# Optional browser-direct endpoint; when set, it must be HTTPS.
NUXT_PUBLIC_DIRECT_API_BASE=
# Optional browser WebSocket endpoint; when set, it must be WSS.
NUXT_PUBLIC_WS_BASE=

# Optional Nuxt runtime settings.
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
# NUXT_BUILD_DIR=
